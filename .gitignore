# Private acquisitions can contain personal data and device-specific secrets.
# Publish only reviewed exports under research/.
/backups/

# macOS filesystem metadata.
.DS_Store

# Python bytecode cache.
__pycache__/
*.pyc

# Local virtual environment for the tools that need PyYAML (patchkit, mapping).
# Bootstrap with: python3 -m venv .venv && .venv/bin/pip install pyyaml
/.venv/

# Splayed boot/vendor_boot payloads produced by the mapping composer. Derived
# from `backups/` (gitignored), regeneratable via `tools/mapping/profile.py`.
profiles/*/_payloads/

# Local-only scratchpad: large binary firmware artefacts, build intermediates,
# session dumps. Preserved for reproducibility but not committed (Apple IP + size).
/.scratchpad-local/

# stage1-opw2 build artifacts
tools/watchos/stage1-opw2/stage1.bin
tools/watchos/stage1-opw2/stage1.elf
tools/watchos/stage1-opw2/stage1-slot-b.img

# boot-watchos payload build artifacts
tools/opwwe231/boot-watchos-payload/boot-watchos
tools/opwwe231/boot-watchos-payload/boot-watchos.stripped

# sn0wmenu9 build artifacts (keep source only)
tools/opwwe231/recovery-menu/src/sn0wmenu9
tools/opwwe231/recovery-menu/src/sn0wmenu9.stripped

# kmod-sn0w build artifacts (output .ko etc.)
tools/opwwe231/kmod-sn0w/sn0w_hello.ko
tools/opwwe231/kmod-sn0w/*.o
tools/opwwe231/kmod-sn0w/*.mod
tools/opwwe231/kmod-sn0w/*.mod.c
tools/opwwe231/kmod-sn0w/*.cmd
tools/opwwe231/kmod-sn0w/.*.cmd
tools/opwwe231/kmod-sn0w/Module.symvers
tools/opwwe231/kmod-sn0w/modules.order
tools/opwwe231/kmod-sn0w/src/*.o
tools/opwwe231/kmod-sn0w/src/.*.cmd
tools/opwwe231/kmod-sn0w/build/
