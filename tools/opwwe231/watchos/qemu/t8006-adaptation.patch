+    /* *(uint32_t *)vtop_static(0xFFFFFFF007D2B5B4) = 0x52800020; */
+    /* *(uint32_t *)vtop_static(0xFFFFFFF007D2B5B8) = 0xd65f03c0; */
+
+    /* sn0w (bring-up, "skip extras"): skip the ApplePMGRMTRSensor perf-state
