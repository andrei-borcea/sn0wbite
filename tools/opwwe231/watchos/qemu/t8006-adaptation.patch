diff --git a/hw/arm/apple_a13.c b/hw/arm/apple_a13.c
index d304c75..171f1d1 100644
--- a/hw/arm/apple_a13.c
+++ b/hw/arm/apple_a13.c
@@ -635,8 +635,7 @@ AppleA13State *apple_a13_cpu_create(DTBNode *node)
     tcpu->phys_id = *(unsigned int*)prop->value;
 
     prop = find_dtb_prop(node, "cluster-id");
-    assert(prop->length == 4);
-    tcpu->cluster_id = *(unsigned int*)prop->value;
+    tcpu->cluster_id = prop ? *(unsigned int*)prop->value : 0; /* Tempest (S5) is single-cluster: prop absent */
 
     mpidr = 0LL | tcpu->phys_id | (1LL << 31);
 
@@ -647,7 +646,7 @@ AppleA13State *apple_a13_cpu_create(DTBNode *node)
     cpu->midr = FIELD_DP64(cpu->midr, MIDR_EL1, REVISION, 0x1);
 
     prop = find_dtb_prop(node, "cluster-type");
-    switch (prop->value[0]) {
+    switch (prop ? prop->value[0] : 'E') {
     case 'P':
         mpidr |= 1 << MPIDR_AFF2_SHIFT;
         cpu->midr = FIELD_DP64(cpu->midr, MIDR_EL1, PARTNUM, 0x12); /* Lightning */
