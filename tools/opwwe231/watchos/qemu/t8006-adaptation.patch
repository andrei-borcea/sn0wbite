 /*
@@ -137,6 +144,123 @@ static void t8030_start_cpus(MachineState* machine, uint64_t cpu_mask)
     }
 }
 
+/*
+ * sn0w: minimal Apple DockChannel UART -- the watchOS S5 serial console (the
+ * Samsung uart0 is NOT the console on this SoC). Register layout from XNU 6153
+ * pexpert/pexpert/arm/dockchannel.h + pexpert/arm/pe_serial.c, channel 0:
+ *   WDATA1 (TX)            = uart_base + 0x4004
+ *   WSTAT  (TX free space) = uart_base + 0x4014  (low 9 bits = free slots)
+ *   RDATA0 (RX count)      = uart_base + 0x4018  (low 7 bits)
+ *   RDATA1 (RX char)       = uart_base + 0x401c  ((>>8) & 0xff)
+ *   DOCK_RDATA1            = uart_base + 0xc01c  (init reads once)
+ *   AGENT AP INTR regs     = agent_base + 0x00..0x0c
+ * We model just enough for the kernel's polled console: WSTAT always reports
+ * free space so serial_init's `while (!tr0())` exits, TX bytes go to the
+ * chardev, RX reports empty. reg = [uart_base, uart_len, agent_base, agent_len].
+ */
+typedef struct DockChannelUartState {
+    CharBackend chr;
+    MemoryRegion uart_iomem;
+    MemoryRegion agent_iomem;
+} DockChannelUartState;
+
+static uint64_t dockchannel_uart_mr_read(void *opaque, hwaddr off, unsigned size)
+{
+    switch (off) {
+    case 0x4014: /* WSTAT: low 9 bits = TX FIFO free slots; always "space" */
+        return 0x1ff;
+    default:     /* RDATA0/RDATA1/DOCK_RDATA1: no RX; everything else 0 */
+        return 0;
+    }
+}
+
+static void dockchannel_uart_mr_write(void *opaque, hwaddr off, uint64_t val,
+                                      unsigned size)
+{
+    DockChannelUartState *s = opaque;
+
+    if (off == 0x4004) { /* WDATA1: transmit one byte to the chardev */
+        uint8_t ch = (uint8_t)val;
+        qemu_chr_fe_write_all(&s->chr, &ch, 1);
+    }
+    /* DRAIN_CFG (0x0008) and all other registers: accepted and ignored */
+}
+
+static const MemoryRegionOps dockchannel_uart_mr_ops = {
+    .read = dockchannel_uart_mr_read,
+    .write = dockchannel_uart_mr_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static uint64_t dockchannel_agent_mr_read(void *opaque, hwaddr off, unsigned size)
+{
+    return 0; /* AP interrupt enable/status: no pending interrupts */
+}
+
+static void dockchannel_agent_mr_write(void *opaque, hwaddr off, uint64_t val,
+                                       unsigned size)
+{
+    /* init does read-modify-write to clear the enables; accept and ignore */
+}
+
+static const MemoryRegionOps dockchannel_agent_mr_ops = {
+    .read = dockchannel_agent_mr_read,
+    .write = dockchannel_agent_mr_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void t8030_create_dockchannel(T8030MachineState *tms, Chardev *chr)
+{
+    DTBNode *node = find_dtb_node(tms->device_tree, "arm-io/dockchannel-uart");
+    DTBProp *prop;
+    hwaddr *reg;
+    DockChannelUartState *s;
+
+    if (node == NULL) {
+        return;
+    }
+    /*
+     * sn0w T8006: the dockchannel-uart node (our pexpert console) lacks a
+     * "channel-number" property (unlike dockchannel-diags=1 / dockchannel-rtp=0),
+     * so the IOKit AppleDockChannel driver that also matches it (by
+     * device_type "dockchannel") panics with "Invalid channel-number". Give it
+     * channel 0 (the uart channel) so the driver's start succeeds; the pexpert
+     * polled console is unaffected.
+     */
+    if (find_dtb_prop(node, "channel-number") == NULL) {
+        uint32_t chan = 0;
+        set_dtb_prop(node, "channel-number", 4, &chan);
+    }
+    prop = find_dtb_prop(node, "reg");
+    assert(prop != NULL && prop->length >= 4 * sizeof(hwaddr));
+    reg = (hwaddr *)prop->value;
+
+    s = g_new0(DockChannelUartState, 1);
+    if (chr != NULL) {
+        qemu_chr_fe_init(&s->chr, chr, &error_abort);
+    }
+    /*
+     * The DockChannel register windows sit INSIDE the broad PMGR placeholder
+     * range (pmgr "reg" covers soc+0x3d100000..+0x3d1a0000 on this DT, which
+     * swallows both DockChannel windows). Map the real device at priority 1 so
+     * it shadows that placeholder for its exact sub-ranges -- same technique as
+     * the boot-display vram mapping below.
+     */
+    memory_region_init_io(&s->uart_iomem, OBJECT(tms), &dockchannel_uart_mr_ops,
+                          s, "dockchannel-uart", reg[1]);
+    memory_region_add_subregion_overlap(tms->sysmem, tms->soc_base_pa + reg[0],
+                                        &s->uart_iomem, 1);
+    memory_region_init_io(&s->agent_iomem, OBJECT(tms),
+                          &dockchannel_agent_mr_ops, s, "dockchannel-agent",
+                          reg[3]);
+    memory_region_add_subregion_overlap(tms->sysmem, tms->soc_base_pa + reg[2],
+                                        &s->agent_iomem, 1);
+}
+
 static void t8030_create_s3c_uart(const T8030MachineState *tms, uint32_t port,
                                   Chardev *chr)
 {
@@ -174,6 +298,75 @@ static void t8030_patch_kernel(struct mach_header_64 *hdr)
